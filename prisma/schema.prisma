generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum AssetStatus {
  ACTIVE
  FAULTY
  DECOMMISSIONED
}

enum TransmitterType {
  AIR
  LIQUID
}

enum SiteStatus {
  ACTIVE
  DOWN
}

enum TowerType {
  GBC
  KNET
}

enum ActivityType {
  USER_LOGIN
  USER_LOGOUT
  SITE_CREATED
  SITE_UPDATED
  SITE_STATUS_CHANGED
  SITE_TOWER_UPDATED
  SITE_HEIGHT_UPDATED
  SITE_GPS_UPDATED
  SITE_DELETED
  ASSET_CREATED
  ASSET_UPDATED
  ASSET_DELETED
  ASSET_STATUS_CHANGED
  ASSET_SERIAL_UPDATED
  INVENTORY_ITEM_CREATED
  INVENTORY_ITEM_UPDATED
  INVENTORY_ITEM_DELETED
  INVENTORY_RESTOCK_ADDED
  INVENTORY_ITEM_ISSUED
  INVENTORY_EQUIPMENT_RETURNED
  INVENTORY_LOW_STOCK
  INVENTORY_OUT_OF_STOCK
  INVENTORY_IMPORT
  SYSTEM_EVENT
  STORE_ITEM_STATUS_CHANGED
  STORE_ITEM_DELETED
  WAREHOUSE_ISSUE_CREATED
  WAREHOUSE_ISSUE_RETURNED
  INVENTORY_DELIVERY_CONFIRMED
}

// Delivery to one of the 42 broadcast sites. Null = no tracking (no destination, or an "Other" place).
enum DeliveryStatus {
  PENDING
  DELIVERED
  RETURNED // everything came back to the store; nothing was used at the destination
}

enum StoreStatus {
  RECEIVED
  NOT_RECEIVED
}

enum InventoryItemType {
  EQUIPMENT
  ACCESSORIES
  TOOLS_AND_PARTS
  GENERAL
  COOLING_INFRASTRUCTURE
  CABLES_AND_ELECTRONICS
  ACCESSORIES_AND_PARTS
  TOOLS_AND_MAINTENANCE
  CABLES_AND_ELECTRICALS
}

enum EquipmentCondition {
  NEW
  UNUSED
  USED
  FAULTY
}

enum InventoryItemStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  CHECKED_OUT
  INACTIVE
}

enum InventoryIssueStatus {
  ISSUED
  RETURNED
}

enum WarehouseIssueStatus {
  OPEN
  RETURNED
}

model UserProfile {
  id                  String    @id @default(cuid())
  email               String    @unique
  fullName            String?
  role                Role      @default(VIEWER)
  isMasterAdmin       Boolean   @default(false)
  passwordHash        String?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  isEmergency         Boolean   @default(false)
  accessExpiresAt     DateTime?
  mustChangePassword  Boolean   @default(false)
  canSeeNotifications Boolean   @default(false)
  // Master admins: security events after this time count on the Security badge.
  securitySeenAt      DateTime?
  isSuspended         Boolean   @default(false)
  suspendedAt         DateTime?
  suspendedBy         String?
  suspendReason       String?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginMethod     String?
  // Area access (master admins always have both). At least one is on.
  siteAccess          Boolean   @default(true)
  storeAccess         Boolean   @default(true)
  // true = every warehouse at full level; false = only the warehouses in storeAccessList.
  allStores           Boolean   @default(true)
  storeAccessList     UserStoreAccess[]
  // Email alerts (set by a master admin). Kinds: ISSUED, DELIVERED, RETURNED, STOCK.
  emailAlerts         Boolean   @default(false)
  emailAlertKinds     String[]  @default([])
  alertEmail          String?   // send alerts here instead of the sign-in email (optional)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum StoreAccessLevel {
  FULL // whatever the user's role allows
  VIEW // read-only at this warehouse
}

// Which warehouses a user may see (used when UserProfile.allStores is false).
model UserStoreAccess {
  id              String           @id @default(cuid())
  userId          String
  inventorySiteId String
  level           StoreAccessLevel @default(FULL)
  createdAt       DateTime         @default(now())

  user          UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventorySite InventorySite @relation(fields: [inventorySiteId], references: [id], onDelete: Cascade)

  @@unique([userId, inventorySiteId])
  @@index([inventorySiteId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Site {
  id              String          @id @default(cuid())
  name            String
  regMFreq        String?
  power           Int?
  transmitterType TransmitterType @default(AIR)
  status          SiteStatus      @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?
  towerType       TowerType       @default(GBC)
  towerHeight     Int?
  gps             String?
  locationName    String?
  vrmId           String?         @unique
  fuelCapacity    Int?            @default(1000)
  fuelLevel       Float?
  lastFuelUpdate  DateTime?
  txMux1Serial    String?
  txMux2Serial    String?
  txMux3Serial    String?
  isDeleted       Boolean         @default(false)
  deletedAt       DateTime?
  deletedByEmail  String?
  deleteReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assets     Asset[]
  deliveries WarehouseIssue[]

  @@unique([name, isDeleted])
  @@index([isDeleted])
  @@index([deletedAt])
}

model ActivityLog {
  id         String       @id @default(cuid())
  type       ActivityType
  title      String
  details    String?
  entityType String?
  entityId   String?
  actorEmail String?
  // Warehouse this entry is about (filled by a database trigger) — limits what restricted users see.
  inventorySiteId String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([inventorySiteId])
  @@index([type])
  @@index([actorEmail])
  @@index([entityType])
  @@index([entityId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  assets        Asset[]
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  assets   Asset[]

  @@unique([categoryId, name])
}

model Asset {
  id             String      @id @default(cuid())
  siteId         String
  categoryId     String
  subcategoryId  String?
  assetName      String
  serialNumber   String?
  manufacturer   String?
  model          String?
  partNumber     String?
  status         AssetStatus @default(ACTIVE)
  specs          Json        @default("{}")
  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?
  deletedByEmail String?
  deleteReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  site        Site         @relation(fields: [siteId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@index([siteId])
  @@index([categoryId])
  @@index([serialNumber])
  @@index([isDeleted])
  @@index([deletedAt])
}

model StoreItem {
  id             String      @id @default(cuid())
  itemNo         Int
  description    String
  quantity       Int
  status         StoreStatus
  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?
  deletedByEmail String?
  deleteReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([itemNo, isDeleted])
  @@index([status])
  @@index([itemNo])
  @@index([isDeleted])
  @@index([deletedAt])
}

model InventorySite {
  id             String    @id @default(cuid())
  name           String
  location       String?
  description    String?
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedByEmail String?
  deleteReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items           InventoryItem[]
  restocks        InventoryRestock[]
  issues          InventoryIssue[]
  warehouseIssues WarehouseIssue[]
  itemTypes       WarehouseItemType[]
  userAccess      UserStoreAccess[]

  @@unique([name, isDeleted])
  @@index([isDeleted])
  @@index([deletedAt])
}

model InventoryItem {
  id               String              @id @default(cuid())
  inventorySiteId  String
  // Legacy fixed category (kept filled so older code and rollbacks still work; custom types store GENERAL).
  itemType         InventoryItemType
  // Managed item type + optional sub-type (Admin → Item Types).
  typeId           String?
  subTypeId        String?
  itemCode         String?             @unique
  name             String
  description      String?
  manufacturer     String?
  model            String?
  quantity         Int                 @default(0)
  uncountable      Boolean             @default(false)
  unit             String?
  reorderLevel     Int                 @default(0)
  targetStockLevel Int?
  status           InventoryItemStatus @default(AVAILABLE)
  condition        EquipmentCondition  @default(NEW)
  isDeleted        Boolean             @default(false)
  deletedAt        DateTime?
  deletedByEmail   String?
  deleteReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  inventorySite   InventorySite      @relation(fields: [inventorySiteId], references: [id])
  typeRef         ItemType?          @relation("ItemMainType", fields: [typeId], references: [id], onDelete: Restrict)
  subType         ItemType?          @relation("ItemSubType", fields: [subTypeId], references: [id], onDelete: Restrict)
  instances       AssetInstance[]
  restocks        InventoryRestock[]
  issues          InventoryIssue[]
  warehouseIssues WarehouseIssue[]

  @@index([inventorySiteId])
  @@index([itemType])
  @@index([typeId])
  @@index([subTypeId])
  @@index([itemCode])
  @@index([status])
  @@index([name])
  @@index([isDeleted])
  @@index([deletedAt])
}

model AssetInstance {
  id              String              @id @default(cuid())
  inventoryItemId String
  entityCode      String              @unique
  serialNumber    String?
  model           String?
  manufacturer    String?
  condition       EquipmentCondition  @default(NEW)
  status          InventoryItemStatus @default(AVAILABLE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  inventoryItem       InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouseIssueLines WarehouseIssueLine[]

  @@index([inventoryItemId])
  @@index([entityCode])
  @@index([serialNumber])
}

model InventoryRestock {
  id              String    @id @default(cuid())
  inventoryItemId String
  inventorySiteId String
  quantityAdded   Int
  dateBought      DateTime?
  dateReceived    DateTime
  supplier        String?
  receivedBy      String?
  note            String?
  createdAt       DateTime  @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventorySite InventorySite @relation(fields: [inventorySiteId], references: [id])

  @@index([inventoryItemId])
  @@index([inventorySiteId])
  @@index([dateReceived])
}

model InventoryIssue {
  id                 String               @id @default(cuid())
  inventoryItemId    String
  inventorySiteId    String
  itemType           InventoryItemType
  quantity           Int                  @default(1)
  requesterName      String
  requesterContact   String?
  department         String?
  purpose            String
  authorizedBy       String
  issuedAt           DateTime             @default(now())
  expectedReturnDate DateTime?
  conditionAtIssue   EquipmentCondition?
  returnedBy         String?
  returnContact      String?
  returnedAt         DateTime?
  returnCondition    EquipmentCondition?
  returnNote         String?
  status             InventoryIssueStatus @default(ISSUED)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventorySite InventorySite @relation(fields: [inventorySiteId], references: [id])

  @@index([inventoryItemId])
  @@index([inventorySiteId])
  @@index([status])
  @@index([issuedAt])
  @@index([returnedAt])
}

model WarehouseIssue {
  id                String               @id @default(cuid())
  groupId           String?
  inventorySiteId   String
  inventoryItemId   String
  quantityTaken     Int                  @default(1)
  takenBy           String
  takenByContact    String?
  authorizedBy      String?
  conditionAtIssue  String?
  purpose           String
  takenAt           DateTime             @default(now())
  expectedReturnAt  DateTime?
  returnedBy        String?
  returnedAt        DateTime?
  returnNote        String?
  status            WarehouseIssueStatus @default(OPEN)
  // Where the item is going: one of the 42 sites (destinationSiteId) or any typed place.
  // destinationName always holds the readable name, so the waybill still reads correctly later.
  destinationSiteId String?
  destinationName   String?
  deliveryStatus    DeliveryStatus?
  deliveredAt       DateTime?
  deliveredBy       String?
  deliveryNote      String?
  // Usage and partial returns: issued = used + returned + still out.
  // quantityUsed is null until someone reports how many were used.
  quantityUsed      Int?
  quantityReturned  Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  inventorySite   InventorySite        @relation(fields: [inventorySiteId], references: [id])
  inventoryItem   InventoryItem        @relation(fields: [inventoryItemId], references: [id])
  lines           WarehouseIssueLine[]
  destinationSite Site?                @relation(fields: [destinationSiteId], references: [id], onDelete: SetNull)
  returns         IssueReturn[]

  @@index([destinationSiteId])
  @@index([deliveryStatus])
  @@index([groupId])
  @@index([inventorySiteId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([takenAt])
}

model WarehouseIssueLine {
  id               String @id @default(cuid())
  warehouseIssueId String
  assetInstanceId  String

  // Tracked units: installed at the destination, or brought back to the store.
  usedAt     DateTime?
  returnedAt DateTime?

  warehouseIssue WarehouseIssue @relation(fields: [warehouseIssueId], references: [id], onDelete: Cascade)
  assetInstance  AssetInstance  @relation(fields: [assetInstanceId], references: [id])

  @@index([warehouseIssueId])
  @@index([assetInstanceId])
}

// One record per return received at the store (several partial returns are allowed per issued item).
model IssueReturn {
  id               String             @id @default(cuid())
  warehouseIssueId String
  quantity         Int
  condition        EquipmentCondition
  entityCodes      String[]           @default([])
  returnedBy       String // person who brought it back
  receivedBy       String // account that recorded it
  note             String?
  receivedAt       DateTime           @default(now())

  warehouseIssue WarehouseIssue @relation(fields: [warehouseIssueId], references: [id], onDelete: Cascade)

  @@index([warehouseIssueId])
  @@index([receivedAt])
}

// Bell notifications. History is kept; NotificationRead records who has opened each one.
model Notification {
  id         String   @id @default(cuid())
  type       String
  title      String
  body       String?
  link       String?
  actorEmail String?
  // Warehouse this is about (filled by a database trigger from the link) — only its users are notified.
  inventorySiteId String?
  createdAt  DateTime @default(now())

  reads NotificationRead[]

  @@index([inventorySiteId])

  @@index([createdAt])
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model MqttConfig {
  id             String   @id @default(cuid())
  connectionName String
  clusterUrl     String
  mqttPort       Int      @default(8883)
  websocketPort  Int      @default(8884)
  username       String
  password       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuthProviderConfig {
  provider        String   @id
  enabled         Boolean  @default(false)
  displayName     String?
  clientId        String?
  clientSecretEnc String?
  tenantId        String?
  issuer          String?
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

// Alert emails waiting to be sent / sent / failed. Sending never blocks the action that raised the alert.
model EmailOutbox {
  id             String    @id @default(cuid())
  toEmail        String
  userId         String?
  kind           String    // ISSUED | DELIVERED | RETURNED | STOCK
  subject        String
  html           String
  notificationId String?
  status         String    @default("PENDING") // PENDING | SENDING | SENT | FAILED
  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model MailConfig {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  tenantId        String?
  clientId        String?
  clientSecretEnc String?
  senderEmail     String?
  companyDomain   String?
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

// Item types (main) and sub-types (parentId set). Managed by admins in Admin → Item Types.
model ItemType {
  id          String             @id @default(cuid())
  name        String
  parentId    String? // null = main item type; set = sub-type of that type
  legacyKey   InventoryItemType? @unique // the 9 original fixed types
  defaultCode String? // main types: short code suggested for warehouses
  tracked     Boolean            @default(false) // main types: units tracked one by one (like Equipment)
  createdBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  parent     ItemType?           @relation("ItemTypeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   ItemType[]          @relation("ItemTypeTree")
  warehouses WarehouseItemType[]
  items      InventoryItem[]     @relation("ItemMainType")
  subItems   InventoryItem[]     @relation("ItemSubType")

  @@index([parentId])
}

// Which warehouses use which item types / sub-types, and each warehouse's short code for a main type.
model WarehouseItemType {
  id              String   @id @default(cuid())
  inventorySiteId String
  itemTypeId      String
  code            String? // main types only: short code used in this warehouse's item codes
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventorySite InventorySite @relation(fields: [inventorySiteId], references: [id], onDelete: Cascade)
  itemType      ItemType      @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)

  @@unique([inventorySiteId, itemTypeId])
  @@index([itemTypeId])
}
